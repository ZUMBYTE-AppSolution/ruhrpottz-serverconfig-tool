<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>PZServerArchitect</AssemblyName>
    <ApplicationIcon>..\..\main\resources\assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\..\main\resources\assets\icons\*.png" Link="Assets\icons\%(Filename)%(Extension)" />
    <Content Include="..\..\main\resources\HANDBUCH.md" Link="HANDBUCH.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
